# ────────────────────────────────────────────────────────────────────
# TOUBA TECH — Template de variables d'environnement
# ────────────────────────────────────────────────────────────────────
# 1. Copie ce fichier en .env.local (à la racine du projet)
# 2. Remplis chaque ligne avec tes vraies clés
# 3. NE COMMIT JAMAIS .env.local — il est déjà dans .gitignore
# ────────────────────────────────────────────────────────────────────

# ── SUPABASE ─────────────────────────────────────────────────────
# Settings → API dans ton dashboard Supabase

# Project URL (commence par https://, finit par .supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé "anon" "public" — exposée côté client (OK)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé "service_role" "secret" — JAMAIS exposée côté client
# Utilisée uniquement par les API routes (insertion form)
SUPABASE_SERVICE_ROLE_KEY=eyJ...


# ── RESEND (envoi d'emails) ──────────────────────────────────────
# Crée un compte sur https://resend.com puis API Keys → Create

RESEND_API_KEY=re_...

# Adresse d'envoi
# - Pour DÉVELOPPEMENT : laisse onboarding@resend.dev (Resend t'autorise
#   à envoyer SEULEMENT vers l'email de ton compte Resend)
# - Pour PROD : remplace par contact@toubatech.eu après validation DNS
RESEND_FROM_EMAIL=contact@toubatech.eu

# Email recevant la notification interne pour chaque nouvelle demande
# Mets ton email perso pour les tests, puis l'email équipe en prod
RESEND_TEAM_NOTIFICATION_EMAIL=ton-email-perso@gmail.com


# ── ADMIN BACK-OFFICE ────────────────────────────────────────────
# Console accessible à /admin

# Mot de passe maître — choisis quelque chose de robuste (16+ caractères)
ADMIN_PASSWORD=MotDePasseRobusteAChanger

# Secret pour signer les cookies de session (minimum 32 caractères)
# Génère-le avec : openssl rand -hex 32
# Ou en PowerShell : -join ((1..64) | %{[char]((48..57) + (97..122) | Get-Random)})
ADMIN_SESSION_SECRET=remplace-par-une-chaine-aleatoire-de-32-caracteres-minimum


# ── À VENIR (laisse vide pour l'instant) ──────────────────────────

# Webhook vers le service IA (phase suivante)
# AI_AGENT_WEBHOOK_URL=

# Stripe pour la boutique reconditionné
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secret de la tâche planifiée Vercel qui garde la base Supabase active (/api/cron/keepalive)
CRON_SECRET=une-longue-valeur-aleatoire
