# ════════════════════════════════════════════════════════════════════
# DADA BEAUTY — variables d'environnement (voir ENVIRONMENT.md)
# Copier en .env.local pour le développement. AUCUNE vraie clé ici.
# ════════════════════════════════════════════════════════════════════

# URL publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=https://www.exemple-dadabeauty.sn

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : serveur uniquement (webhooks paiement, upload des devis, création du compte propriétaire)
SUPABASE_SERVICE_ROLE_KEY=

# Sel pour anonymiser les IP avant la limitation anti-abus (chaîne aléatoire longue)
RATE_LIMIT_SALT=

# Environnement de démonstration : affiche un bandeau « Démonstration »
NEXT_PUBLIC_DEMO_MODE=false

# ── Paiements (laisser vide tant que les comptes marchands ne sont pas ouverts) ──
# Wave Business — Checkout API (https://docs.wave.com/checkout)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
# Orange Money Web Payment (Orange Developer / Sonatel) — adaptateur à finaliser avec le contrat marchand
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=

# ── WhatsApp Business Platform (Cloud API Meta) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=fr

# Secret des tâches planifiées Vercel Cron (rappels de rendez-vous) — chaîne aléatoire longue
CRON_SECRET=
