{
  "name": "dada-beauty",
  "version": "0.6.2",
  "private": true,
  "description": "Dada Beauty — site, réservation, boutique et gestion de l'institut (Guédiawaye, Dakar)",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
